MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hoa-app

# Use a long, random value in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production

PORT=5000
# Set to "production" on the deployed server (hides internal error details).
NODE_ENV=development

# Allowed browser origin(s) for CORS. Comma-separated for multiple.
#   Local dev:   http://localhost:5173,http://localhost:5174   (user-app, admin-app)
#   Production:  https://your-user-app-domain.com,https://your-admin-app-domain.com
#   Android app: add https://localhost (the origin of the Capacitor app)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# QPay Configuration (get real credentials from qpay.mn)
# The callback endpoint refuses all requests (503) until CLIENT_ID/SECRET are
# set, because payments are only marked paid after QPay's API confirms them.
QPAY_CLIENT_ID=your_client_id
QPAY_CLIENT_SECRET=your_client_secret
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_INVOICE_RECEIVER_CODE=your_receiver_code
QPAY_CALLBACK_URL=http://localhost:5000/api/payments/qpay-callback

# Cloudinary (feedback photo uploads). From your Cloudinary dashboard.
# If unset, feedback still works but photo uploads are refused.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

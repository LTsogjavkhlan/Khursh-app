{
    "name": "khursh-backend",
    "version": "1.0.0",
    "description": "HOA Application Backend API",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "node --test \"tests/**/*.test.js\"",

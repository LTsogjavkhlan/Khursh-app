    },
    "dependencies": {
        "axios": "^1.6.2",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.11.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.6.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "multer": "^2.4.0",
        "nodemailer": "^8.0.4",
        "socket.io": "^4.8.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.0.2",
        "socket.io-client": "^4.8.4"
    },
    "allowScripts": {
        "mongodb-memory-server@11.3.0": true
